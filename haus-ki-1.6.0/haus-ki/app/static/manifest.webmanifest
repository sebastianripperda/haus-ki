{
  "name": "Haus-KI",
  "short_name": "Haus-KI",
  "description": "Lokaler KI-Assistent der Familie",
  "lang": "de",
  "start_url": "/#start",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "text/*"] }]
    }
  },
  "shortcuts": [
    { "name": "Neuer Chat", "url": "/#start" },
    { "name": "Gesprächsmodus", "url": "/#talk" }
  ]
}
